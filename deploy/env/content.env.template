CONTENT_LOG_SERVICE_NAME=content
CONTENT_DB=relay_content
CONTENT_APP_USER=content_app
CONTENT_APP_PASSWORD=content_local_app_change_me
CONTENT_MIGRATOR_USER=content_migrator
CONTENT_MIGRATOR_PASSWORD=content_local_migrator_change_me

CONTENT_HTTP_ADDR=:8080
CONTENT_LOG_LEVEL=info
CONTENT_LOG_DEVELOPMENT=false
CONTENT_HTTP_BIND_HOST=127.0.0.1
CONTENT_HTTP_PORT=8080
CONTENT_ALLOWED_ORIGIN=https://localhost
CONTENT_CURSOR_SIGNING_KEY=
CONTENT_SHUTDOWN_TIMEOUT=30s
CONTENT_DB_HOST=postgres
CONTENT_DB_PORT=5432
CONTENT_DB_SSLMODE=disable
CONTENT_DB_MAX_CONNS=10
CONTENT_DB_MIN_CONNS=2
CONTENT_DB_CONNECT_TIMEOUT=5s
CONTENT_ACCESS_PUBLIC_KEY_FILES=local-1=/run/keys/identity-public.pem

# Separate random HMAC secret, at least 32 bytes; shared across Content replicas.
CONTENT_RATE_LIMIT_KEY=
CONTENT_REDIS_TIMEOUT=200ms
CONTENT_REDIS_MAX_CONNS=10
# Refill rate / period / burst; not strict sliding-window counts.
CONTENT_RATE_CAPTURE_USER=30/1m/10
CONTENT_RATE_WRITE_USER=60/1m/20
CONTENT_RATE_READ_USER=300/1m/60
CONTENT_RATE_SEARCH_USER=60/1m/10
