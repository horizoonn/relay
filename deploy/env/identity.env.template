IDENTITY_LOG_SERVICE_NAME=identity
IDENTITY_DB=relay_identity
IDENTITY_APP_USER=identity_app
IDENTITY_APP_PASSWORD=identity_local_app_change_me
IDENTITY_MIGRATOR_USER=identity_migrator
IDENTITY_MIGRATOR_PASSWORD=identity_local_migrator_change_me

# Runtime behind Nginx; key generation: deploy/identity/README.md
IDENTITY_LOG_LEVEL=info
IDENTITY_LOG_DEVELOPMENT=false
IDENTITY_ALLOWED_ORIGIN=https://localhost
# Separate random secret, at least 32 bytes; preserve across restarts/replicas.
IDENTITY_CURSOR_SIGNING_KEY=
IDENTITY_SIGNING_KEY_ID=local-1
# Optional previous key IDs mapped to read-only PUBLIC KEY PEM mounts.
# Format: old-id=/run/keys/old-public.pem,older-id=/run/keys/older-public.pem
IDENTITY_SIGNING_PUBLIC_KEY_FILES=
IDENTITY_SHUTDOWN_TIMEOUT=30s
IDENTITY_MAX_PARALLEL_PASSWORDS=2
# Concurrent SMTP jobs per Identity process; bounded to 1..4.
IDENTITY_EMAIL_WORKERS=2
IDENTITY_DB_SSLMODE=disable
IDENTITY_DB_MAX_CONNS=10
IDENTITY_DB_MIN_CONNS=2
IDENTITY_DB_CONNECT_TIMEOUT=5s

# Independent HMAC secret shared across Identity replicas; at least 32 bytes.
IDENTITY_RATE_LIMIT_KEY=
# Only Nginx and Identity join this network. Change if it overlaps local routing.
IDENTITY_PROXY_SUBNET=172.31.254.0/28
IDENTITY_REDIS_TIMEOUT=200ms
IDENTITY_REDIS_MAX_CONNS=10
# Rules are refill rate / period / burst, not strict sliding-window counts.
IDENTITY_RATE_LOGIN_IP=30/1m/10
IDENTITY_RATE_LOGIN_ACCOUNT=5/1m/5
IDENTITY_RATE_REGISTER_IP=6/1h/3
IDENTITY_RATE_REFRESH_IP=120/1m/30
IDENTITY_RATE_READ_USER=120/1m/30
IDENTITY_RATE_LOGOUT_IP=30/1m/10
IDENTITY_RATE_REVOKE_USER=30/1m/10

# Independent random key for encrypted email jobs, at least 32 bytes.
IDENTITY_MAIL_ENCRYPTION_KEY=
IDENTITY_SMTP_ADDR=mailpit:1025
IDENTITY_SMTP_FROM=no-reply@relay.local
IDENTITY_SMTP_USERNAME=
IDENTITY_SMTP_PASSWORD=
# Local Mailpit only; require STARTTLS in production.
IDENTITY_SMTP_ALLOW_INSECURE=true
IDENTITY_SMTP_TIMEOUT=5s
IDENTITY_RATE_EMAIL_IP=30/1h/5
IDENTITY_RATE_EMAIL_ACCOUNT=5/1h/2
IDENTITY_RATE_ACTION_IP=30/1m/10
